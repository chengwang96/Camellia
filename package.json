{
  "name": "camellia-desktop",
  "version": "0.1.0",
  "description": "Camellia: a shared workbench for Claude Code, Codex CLI, DSH, Kimi Code and Antigravity",
  "main": "src/main/main.js",
  "author": "Camellia contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "setup:kimi": "node scripts/prepare-runtimes.cjs kimi",
    "setup:dsh": "node scripts/prepare-runtimes.cjs dsh",
    "setup:claude": "node scripts/prepare-runtimes.cjs claude",
    "test:kimi": "node tests/kimi-cli-smoke.cjs",
    "test": "node --test tests/*.test.js",
    "dev": "electron .",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "build:icons": "electron scripts/build-icons.cjs",
    "setup:runtimes": "node scripts/prepare-runtimes.cjs",
    "postinstall": "node scripts/prepare-runtimes.cjs --check",
    "prestart": "node scripts/prepare-runtimes.cjs --check",
    "predev": "node scripts/prepare-runtimes.cjs --check",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --arm64",
    "pack:mac": "electron-builder --mac --arm64 --dir",
    "setup:antigravity": "node scripts/prepare-runtimes.cjs antigravity",
    "test:antigravity": "node tests/antigravity-smoke.cjs",
    "test:benchmark": "node tests/benchmark-native-smoke.cjs",
    "test:benchmark:science": "node tests/benchmark-science-smoke.cjs",
    "setup:antigravity:subscription": "node scripts/prepare-runtimes.cjs antigravity --google-subscription",
    "test:antigravity:subscription": "node tests/antigravity-subscription-smoke.cjs",
    "setup:codex": "node scripts/prepare-runtimes.cjs codex",
    "test:codex": "node tests/codex-smoke.cjs",
    "test:tools": "node tests/tools-native-audit.cjs"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.dsh.desktop",
    "productName": "Camellia",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/icon-256.png",
      "assets/brands/**/*",
      "scripts/ollama-proxy-cli.js",
      "scripts/ollama-switch-account.ps1",
      "integrations/dsh/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtimes/kimi",
        "to": "runtimes/kimi",
        "filter": [
          "package.json",
          "README.md",
          "package-lock.json"
        ]
      },
      {
        "from": "runtimes/dsh",
        "to": "runtimes/dsh",
        "filter": [
          "package.json",
          "package-lock.json"
        ]
      },
      {
        "from": "runtimes/claude",
        "to": "runtimes/claude",
        "filter": [
          "package.json",
          "package-lock.json"
        ]
      },
      {
        "from": "runtimes/codex",
        "to": "runtimes/codex",
        "filter": [
          "package.json",
          "package-lock.json"
        ]
      },
      {
        "from": "build/runtime-assets",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "runtimes/antigravity",
        "to": "runtimes/antigravity",
        "filter": [
          "runtime.json",
          "requirements.lock",
          "README.md"
        ]
      }
    ],
    "beforePack": "./scripts/prepare-package.cjs",
    "win": {
      "target": [
        "nsis",
        "zip",
        "portable"
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-win-${arch}.${ext}",
      "useZip": true,
      "differentialPackage": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "assets/icon-1024.png",
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}",
      "extendInfo": {
        "CFBundleDevelopmentRegion": "en"
      }
    },
    "asarUnpack": [
      "src/engines/antigravity/**",
      "src/benchmark/python/**"
    ]
  },
  "dependencies": {
    "smol-toml": "^1.8.0",
    "undici": "^8.10.2",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
